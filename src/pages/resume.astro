---
// 이력 페이지  →  주소: /resume
// 항목은 아래 배열만 고치면 화면에 그대로 반영된다.
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../consts';

const experience = [
	{ period: '20XX.XX – 현재', title: '회사 이름 · 직무', detail: '맡은 일을 한두 줄로 적습니다.' },
];

const education = [{ period: '20XX – 20XX', title: '학교 이름 · 전공', detail: '' }];

const skills = ['기술 1', '기술 2', '기술 3'];
---

<BaseLayout title="이력" description={`${AUTHOR.name} 이력`}>
	<h1>이력</h1>

	<section>
		<h2>경력</h2>
		{
			experience.map((item) => (
				<div class="item">
					<p class="muted">{item.period}</p>
					<h3>{item.title}</h3>
					{item.detail && <p>{item.detail}</p>}
				</div>
			))
		}
	</section>

	<section>
		<h2>학력</h2>
		{
			education.map((item) => (
				<div class="item">
					<p class="muted">{item.period}</p>
					<h3>{item.title}</h3>
					{item.detail && <p>{item.detail}</p>}
				</div>
			))
		}
	</section>

	<section>
		<h2>기술</h2>
		<ul class="tags">
			{skills.map((skill) => <li>{skill}</li>)}
		</ul>
	</section>
</BaseLayout>

<style>
	section {
		margin-bottom: 40px;
	}
	h2 {
		padding-bottom: 6px;
		border-bottom: 1px solid var(--border);
	}
	.item {
		margin-bottom: 20px;
	}
	.item h3 {
		margin: 0;
		font-size: 1.05rem;
	}
	.item p {
		margin: 0;
	}
</style>
