---
// 상단 메뉴. 지금 보고 있는 페이지의 메뉴를 굵게 표시한다.
import { SITE_TITLE, NAV_ITEMS } from '../consts';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
	return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<header>
	<div class="container bar">
		<a class="logo" href="/">{SITE_TITLE}</a>
		<nav>
			{
				NAV_ITEMS.map((item) => (
					<a href={item.href} class:list={{ active: isActive(item.href) }}>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 16px;
		padding-bottom: 16px;
	}
	.logo {
		color: var(--text);
		font-weight: 700;
	}
	nav {
		display: flex;
		gap: 18px;
	}
	nav a {
		color: var(--text-muted);
	}
	nav a.active {
		color: var(--text);
		font-weight: 700;
	}
</style>
